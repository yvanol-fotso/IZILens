# /etc/izilens/backend.env  (chmod 640, propriétaire root:izilens) - ne jamais commiter ce fichier rempli
ENVIRONMENT=production
LOG_LEVEL=INFO
DOCS_ENABLED=false
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql+psycopg://izilens:MOT_DE_PASSE@127.0.0.1:5432/izilens
DB_POOL_SIZE=10

# Générer avec : python scripts/generate_secrets.py (valeurs distinctes de celles du développement)
JWT_SECRET=GENERER
API_KEY_PEPPER=GENERER
DATA_ENCRYPTION_KEYS=GENERER

STORAGE_DIR=/var/lib/izilens/storage
MAX_UPLOAD_MB=8
HOSTED_JOURNEY_BASE_URL=https://app.example.com/verify
TERMS_VERSION=2026-11

OCR_LANG=fr
OCR_PRELOAD=true
OCR_REVIEW_THRESHOLD=0.90

# Connexion Google (OpenID Connect)
OIDC_ENABLED=true
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
OIDC_ALLOWED_REDIRECT_URIS=https://app.example.com/auth/callback

# E-mails (confirmation de demande, invitations) : smtp en production
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=GENERER
SMTP_STARTTLS=true
EMAIL_FROM=IZI LENS <no-reply@izilens.com>
SALES_EMAIL=ventes@izilens.com
PARTNERSHIPS_EMAIL=partenariats@izilens.com
FRONTEND_URL=https://app.example.com
MFA_ISSUER=IZI LENS
