# /etc/izilens/dashboard.env  (chmod 640, propriétaire root:izilens)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# URL publique exacte du site : indispensable pour que les formulaires soient acceptés
ORIGIN=https://app.example.com
# Taille maximale d'une requête (photos de documents) ; sans cette variable : 512 Ko
BODY_SIZE_LIMIT=20M

BACKEND_SERVICE_URL=http://127.0.0.1:8000
BACKEND_API_PREFIX=/api/v1
BACKEND_LOGIN_FORMAT=json
PUBLIC_APP_URL=https://app.example.com
AUTH_COOKIE_SECURE=true

# Connexion Google (même identifiant client que OIDC_ALLOWED_REDIRECT_URIS côté API)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REDIRECT_URI=https://app.example.com/api/auth/oauth
