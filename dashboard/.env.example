# ── Backend FastAPI (appelé uniquement côté serveur SvelteKit) ──────────────
BACKEND_SERVICE_URL=http://127.0.0.1:8000
BACKEND_API_PREFIX=/api/v1
# json = POST {email,password} · form = OAuth2PasswordRequestForm (username/password)
BACKEND_LOGIN_FORMAT=json

# ── Application ─────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_DOCS_URL=http://127.0.0.1:8000/docs
# false en HTTP local, true derrière HTTPS (par défaut : true en production)
AUTH_COOKIE_SECURE=false

# ── OpenID Connect · « Continuer avec Google » ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optionnel : sinon <origin>/api/auth/oauth (à déclarer dans Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/oauth
