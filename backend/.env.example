ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://izilens:izilens_dev@localhost:5432/izilens

# Générer avec : python scripts/generate_secrets.py
JWT_SECRET=change-me-generate-with-scripts-generate-secrets
API_KEY_PEPPER=change-me-generate-with-scripts-generate-secrets
DATA_ENCRYPTION_KEYS=change-me-generate-with-scripts-generate-secrets

STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=8
HOSTED_JOURNEY_BASE_URL=http://localhost:5173/verify
TERMS_VERSION=2026-11

OCR_LANG=fr
OCR_PRELOAD=true
OCR_REVIEW_THRESHOLD=0.90

# Webhooks : HTTP autorisé uniquement en développement
WEBHOOK_ALLOW_HTTP=true

# Connexion Google (OpenID Connect)
OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback

# E-mails : "console" journalise le contenu (développement uniquement) ; "smtp" en production
EMAIL_BACKEND=console
FRONTEND_URL=http://localhost:5173
SALES_EMAIL=
PARTNERSHIPS_EMAIL=
